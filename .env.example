# === Entra Identity ===
TENANT_ID=your-tenant-id
BLUEPRINT_APP_CLIENT_ID=your-blueprint-app-client-id
CALENDAR_AGENT_IDENTITY_ID=your-calendar-agent-identity-client-id
PROFILE_AGENT_IDENTITY_ID=your-profile-agent-identity-client-id
DIRECTORY_AGENT_IDENTITY_ID=your-directory-agent-identity-client-id

# === Backend ===
SIDECAR_URL=http://localhost:5000
FOUNDRY_PROJECT_ENDPOINT=https://your-ai-services.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL=gpt-5.4-mini

# === Frontend ===
BACKEND_URL=http://localhost:8080
WEB_CLIENT_ID=your-web-client-app-id
SESSION_SECRET=change-this-to-a-random-secret

# === Optional ===
LOG_LEVEL=WARNING                # DEBUG, INFO, WARNING (default), ERROR
ALLOWED_WEB_CLIENT_ID=          # azp claim validation — set to WEB_CLIENT_ID in production
